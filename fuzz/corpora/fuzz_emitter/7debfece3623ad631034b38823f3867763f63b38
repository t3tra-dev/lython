def check(xs: list[int]) -> str:
    ys: list[int] = sorted(xs)
    ordered: bool = True
    i: int = 1
    while i < len(ys):
        if ys[i] < ys[i - 1]:
            ordered = False
        i = i + 1
    return f"{len(ys)} {ordered} {sum(ys) == sum(xs)} {ys[0]} {ys[len(ys) - 1]}"


